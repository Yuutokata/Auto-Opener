# Copy to .env for local development. Real values belong in Dokploy/Phase, never in this file.

# --- Server ---
HOST=0.0.0.0
SERVER_PORT=8080
# Header that carries the real client IP when running behind a reverse proxy, for example X-Forwarded-For.
# Leave empty when the server is reachable directly. Without it all clients behind the proxy share one rate limit.
CLIENT_IP_HEADER=

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=AutoOpener

# --- Authentication (required) ---
# Comma-separated service tokens for the bot, each 32-128 alphanumeric characters (replace the placeholder).
BOT_TOKEN=replace-with-32-to-128-alphanumeric-characters
# HMAC secret for JWTs; use at least 32 random characters.
JWT_SECRET=change-me
JWT_ISSUER=auto-opener
JWT_AUDIENCE=chrome-extension
# Lifetime of issued JWTs in hours.
JWT_TTL_HOURS=72
# When true, /token only accepts users that present their registered secret.
# Keep false until the bot and the extension ship the per-user secret.
REQUIRE_USER_SECRET=false

# --- Rate limits (requests per client and period in seconds) ---
RATE_LIMIT_TOKEN=20
RATE_LIMIT_TOKEN_DURATION=60
RATE_LIMIT_WS=40
RATE_LIMIT_WS_DURATION=60
RATE_LIMIT_SERVICE=100
RATE_LIMIT_SERVICE_DURATION=60

# --- WebSocket ---
# Seconds between keep-alive passes, between pings of one connection, and how long a pong may take.
HEALTH_CHECK_INTERVAL=5
PING_INTERVAL=25
PONG_TIMEOUT=25
MAX_CONNECTIONS_PER_USER=3
WS_MAX_FRAME_SIZE=65536
WS_MASKING=false

# --- Logging ---
LOG_LEVEL=INFO
