{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Auto-Opener: keep Dockerfile and Gradle up to date, never automerge",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "gradle", "gradle-wrapper"],
  "dependencyDashboard": true,
  "pinDigests": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "automerge": false,
  "prBodyNotes": [
    ":warning: Merging into `main` triggers the Dokploy autodeploy of **lightningatc-autoopener** (short bot restart)."
  ],
  "packageRules": [
    {
      "description": "Kotlin plugins (jvm + serialization) always together on the same version",
      "matchDepNames": ["org.jetbrains.kotlin.jvm", "org.jetbrains.kotlin.plugin.serialization"],
      "groupName": "Kotlin",
      "separateMajorMinor": false
    },
    {
      "description": "Ktor Gradle plugin together with the Ktor libraries",
      "matchDepNames": ["io.ktor.plugin"],
      "groupName": "Ktor"
    },
    {
      "description": "Ktor libraries",
      "matchPackageNames": ["io.ktor:**"],
      "groupName": "Ktor"
    },
    {
      "description": "KMongo and KMongo coroutine together",
      "matchPackageNames": ["org.litote.kmongo:**"],
      "groupName": "KMongo"
    }
  ]
}
